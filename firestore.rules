rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hoi.mythuatbs2@gmail.com' ||
        request.auth.token.email == 'ducphuc209219@gmail.com' ||
        request.auth.token.email == 'nguyenhoi.education@gmail.com' ||
        request.auth.token.email == 'animizht1208@gmail.com'
      );
    }

    function isAllowedEmail() {
      return isSignedIn() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email))
      );
    }

    function isOwner(userId) {
      return isAllowedEmail() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health check/connection test path
    match /test/{docId} {
      allow read: if isSignedIn();
    }

    // Allowed users collection
    // Chỉ admin mới có quyền list toàn bộ danh sách và ghi/sửa/xóa
    // Người dùng thường chỉ được đọc (get) bản ghi của chính họ để kiểm tra quyền
    match /allowed_users/{emailDoc} {
      allow list: if isAdmin();
      allow get: if isAdmin() || (isSignedIn() && request.auth.token.email == emailDoc);
      allow create, update, delete: if isAdmin();
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // Settings subcollection
      match /settings/{settingId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(settingId);
        allow delete: if isOwner(userId);
      }

      // Saved plans subcollection
      match /saved_plans/{planId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(planId);
        allow delete: if isOwner(userId);
      }

      // Schedules subcollection
      match /schedules/{scheduleId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(scheduleId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
