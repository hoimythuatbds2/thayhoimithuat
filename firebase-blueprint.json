{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and authorization state",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Teacher profile and school configuration",
      "type": "object",
      "properties": {
        "teacherName": { "type": "string" },
        "schoolName": { "type": "string" },
        "schoolYear": { "type": "string" },
        "approverTitle": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["teacherName", "schoolName", "schoolYear", "approverTitle"]
    },
    "SavedPlan": {
      "title": "SavedPlan",
      "description": "Saved weekly lesson plans generated for art classes",
      "type": "object",
      "properties": {
        "planId": { "type": "string" },
        "userId": { "type": "string" },
        "weekNumber": { "type": "number" },
        "planTitle": { "type": "string" },
        "schoolYear": { "type": "string" },
        "contentJson": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["planId", "userId", "weekNumber", "planTitle"]
    },
    "WeekSchedule": {
      "title": "WeekSchedule",
      "description": "Timetable and calendar for a specific week",
      "type": "object",
      "properties": {
        "weekNumber": { "type": "number" },
        "userId": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "holidays": { "type": "string" },
        "timetableJson": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["weekNumber", "userId"]
    },
    "AllowedUser": {
      "title": "AllowedUser",
      "description": "Authorized email allowed to access and use the application",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "note": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "status"]
    }
  },
  "firestore": {
    "/allowed_users/{emailDoc}": {
      "schema": { "$ref": "#/entities/AllowedUser" },
      "description": "Collection of authorized user emails allowed to use the app"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "User specific application settings"
    },
    "/users/{userId}/saved_plans/{planId}": {
      "schema": { "$ref": "#/entities/SavedPlan" },
      "description": "Weekly lesson plans generated by the teacher"
    },
    "/users/{userId}/schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/WeekSchedule" },
      "description": "User timetable adjustments per week"
    }
  }
}
